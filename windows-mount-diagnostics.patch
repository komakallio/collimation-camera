+func testEQ6ConnectionFailureDetails() throws {
+    // Every setup failure used to become just "Could not open serial port COM10."
+    // Check that the operation, error code, and system text reach the UI intact.
+    for operation in ["CreateFileW", "GetCommState", "BuildCommDCBW", "SetCommState", "SetCommTimeouts"] {
+        let port = ScriptedSerialPortDriver()
+        port.openError = SerialPortError.windowsFailure(
+            operation: operation, code: 5, message: "Access is denied."
+        )
+        let mount = EQ6Mount(port: port)
+        var thrown: Error?
+        do { try mount.connect(path: "COM10") } catch { thrown = error }
+        guard case MountError.connectionFailed(let path, let detail)? = thrown else {
+            throw UIModelExpectation(description: "expected detailed connection failure, got \(String(describing: thrown))")
+        }
+        try expectUI(path == "COM10", "the failing port is preserved")
+        try expectUI(detail.contains(operation), "the failing operation is preserved")
+        try expectUI(detail.contains("Windows error 5"), "the numeric error is preserved")
+        try expectUI(detail.contains("Access is denied."), "the system message is preserved")
+        let dialog = thrown?.localizedDescription ?? ""
+        try expectUI(dialog.contains(path) && dialog.contains(detail), "the dialog includes the port and details")
+        try expectUI(!mount.isConnected && !port.isOpen, "failed connection stays disconnected")
+        try expectUI(port.writes.isEmpty, "no protocol probes after setup failure")
+    }
+
+    let fallback = SerialPortError.windowsFailure(operation: "SetCommState", code: 87, message: "")
+    try expectUI(fallback.localizedDescription.contains("Windows error 87"), "code survives missing system text")
+
+    let port = ScriptedSerialPortDriver()
+    port.openError = SerialPortError.configureFailed
+    do {
+        try EQ6Mount(port: port).connect(path: "SCRIPT")
+        throw UIModelExpectation(description: "configuration failure must throw")
+    } catch MountError.connectionFailed(_, let detail) {
+        try expectUI(detail.contains("settings"), "configuration failure is distinguished from opening failure")
+    }
+}
